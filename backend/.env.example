# Copy to .env for local overrides. Keep real credentials out of source control.
DATABASE_URL=sqlite:///./syncspace.db
APP_ENV=development
AUTH_SECRET_KEY=replace-with-a-random-value-at-least-32-characters-long
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
GOOGLE_CLIENT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
